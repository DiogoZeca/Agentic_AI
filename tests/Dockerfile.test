FROM python:3.12-slim

# libgomp1 is required by XGBoost (OpenMP runtime)
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies (resolve -r chain explicitly to avoid path issues in Docker)
COPY spike/requirements-inference.txt training/requirements-train.txt tests/requirements-test.txt ./
RUN pip install --no-cache-dir \
    $(grep -v '^-r' requirements-inference.txt | tr '\n' ' ') \
    $(grep -v '^-r' requirements-train.txt | tr '\n' ' ') \
    $(grep -v '^-r' requirements-test.txt | tr '\n' ' ')

# Install the spike package
COPY pyproject.toml .
COPY spike/ ./spike/
RUN pip install --no-cache-dir -e .

# Copy remaining source
COPY training/ ./training/
COPY tests/ ./tests/

RUN mkdir -p data

CMD ["python", "-m", "pytest", "tests/", "-v", "--tb=short"]
