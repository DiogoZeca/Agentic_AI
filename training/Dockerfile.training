# ── Spike Prediction Training Image ──────────────────────────────────────────
#
#   Build context: repo root (Agentic_AI/)
#
#   Build and run (from Agentic_AI/):
#     docker compose --profile train run --rm --build train
#
#   Or standalone:
#     docker build -f training/Dockerfile.training -t spike-train .
#     docker run --rm -v $(pwd)/data:/app/data spike-train
#
#   The data directory is bind-mounted — the CSV input and the output artifacts
#   are both written to the host filesystem via the mount point.
#
#   Environment variables (all optional — match training/train.py CLI):
#     DEVICE              compute device: "cpu" (default) or "cuda" for GPU VM
#     DATA_PATH           path to input CSV inside container (default: data/cluster_cpu_data.csv)
#     ARTIFACTS_DIR       output directory for trained artifacts  (default: data/full_run)
#     OPTUNA_TRIALS       number of Optuna hyperparameter trials  (default: 30)
#     MIN_FUTURE_WINDOWS  K-of-N label threshold for severity_in_60m (default: 1)
#
#   GPU notes:
#     - Base image ships CUDA 12.4 runtime; XGBoost pip wheel includes pre-compiled
#       CUDA kernels — no extra packages needed.
#     - Set DEVICE=cuda via docker-compose environment or -e DEVICE=cuda at runtime.
#     - Requires NVIDIA Container Toolkit on the host (see scripts/vm-setup.sh).
#     - _resolve_device() in spike/classifier.py falls back to CPU silently if no
#       CUDA-capable GPU is found, so this image runs on CPU-only hosts too.
# ──────────────────────────────────────────────────────────────────────────────

# Ubuntu 22.04 (Python 3.10); CUDA 12.4 satisfies XGBoost 3.x (≥ 12.0).
# Use the 'runtime' variant — XGBoost's pip wheel ships pre-compiled CUDA kernels;
# the 'devel' image (nvcc + headers) is not needed at training time.
# Note: nvidia/cuda:12.4.1-*-ubuntu24.04 does not exist; Ubuntu 24.04 support
# was added starting from CUDA 12.5. Ubuntu 22.04 is equivalent for our purposes.
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

# python3 (3.10) and pip are the Ubuntu 22.04 defaults.
# libgomp1 is required by XGBoost's OpenMP thread pool (CPU path).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        python3 python3-pip libgomp1 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies
COPY spike/requirements-inference.txt training/requirements-train.txt ./
RUN pip3 install --no-cache-dir \
    $(grep -v '^-r' requirements-inference.txt | tr '\n' ' ') \
    $(grep -v '^-r' requirements-train.txt | tr '\n' ' ')

# Install the spike package
COPY pyproject.toml .
COPY spike/ ./spike/
RUN pip3 install --no-cache-dir -e .

# Copy training scripts
COPY training/ ./training/

# Create artifact output directory — bind-mounted from host at runtime
RUN mkdir -p data/full_run

ENV DEVICE=cpu
ENV DATA_PATH=data/cluster_cpu_data.csv
ENV ARTIFACTS_DIR=data/full_run
ENV OPTUNA_TRIALS=150
ENV MIN_FUTURE_WINDOWS=1
ENV N_ESTIMATORS=4000
ENV FROM_STEP=1

CMD python3 -u training/train.py \
    --data-path          "$DATA_PATH" \
    --artifacts-dir      "$ARTIFACTS_DIR" \
    --tune-hyperparams \
    --optuna-trials      "$OPTUNA_TRIALS" \
    --n-estimators       "$N_ESTIMATORS" \
    --device             "$DEVICE" \
    --min-future-windows "$MIN_FUTURE_WINDOWS" \
    --from-step          "$FROM_STEP"
