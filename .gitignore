# ─── Python bytecode ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyd
*.pyo
*.so

# ─── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Python packaging ────────────────────────────────────────────────────────
*.egg-info/
*.egg
.eggs/
dist/
build/

# ─── Pytest ──────────────────────────────────────────────────────────────────
.pytest_cache/

# ─── Input data (8 GB — re-download with: python data/download_cluster_data.py)
data/cluster_cpu_data.csv

# ─── Large training intermediates (not needed for inference)
# Only these two files are excluded from data/full_run/ — all model artifacts
# in data/full_run/spike*/ (spike_model.json, calibrators.pkl, etc.) ARE tracked.
data/full_run/cluster_agg.parquet
data/full_run/cluster_features.parquet

# ─── Experiment ablation artifacts (large, regeneratable) ────────────────────
data/experiments/

# ─── Parquet files: ignore globally except the inference thresholds ───────────
# spike_thresholds.parquet (180 KB) holds per-machine p95/p99 and is required
# for inference — any domain-specific override goes via --domain-dir instead.
*.parquet
!data/full_run/spike/spike_thresholds.parquet

# ─── Pickle files: ignore globally except the isotonic calibrators ────────────
# calibrators.pkl (32 KB) is required for 60m probability calibration.
*.pkl
!data/full_run/spike/calibrators.pkl

# ─── Databases (Optuna SQLite — not needed for inference) ────────────────────
*.db

# ─── Process logs ────────────────────────────────────────────────────────────
nohup.out
*.log

# ─── Claude Code local settings ──────────────────────────────────────────────
.claude/
CLAUDE.md

# ─── Environment / secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Jupyter ─────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── OS noise ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Editor state ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Internal ops artifacts (real hostnames/usernames — not for public repo) ─
session_anchor.md
data/zabbix_eval/

# ─── bootstrap_thresholds.py output metadata — operator-specific, regeneratable,
# not part of the shipped production model (spike_thresholds.parquet is the
# artifact that actually matters for inference, and it stays tracked above).
bootstrap_meta.json
