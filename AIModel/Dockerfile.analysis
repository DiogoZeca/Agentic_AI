# ── Analysis image ──────────────────────────────────────────────────────────────
# Full dependencies: Prophet + TimesFM + matplotlib + plotly
# Used for: data generation, 8-chart Prophet analysis, ensemble comparison
#
# TimesFM model weights (~925 MB) are NOT baked in — they are downloaded on
# first run and cached in the `hf-cache` named Docker volume.
#
# Note: torch dependency (~2 GB) makes this image large and the initial build
# slow. This is a one-time cost — subsequent builds use the layer cache.
FROM python:3.11-slim

# System deps required by Prophet (cmdstanpy needs a C++ compiler)
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps — full stack including matplotlib, timesfm, torch
# Layer cached separately from source code: only re-runs on requirements change
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Pre-compile cmdstan so analysis runs start fast (C++ compilation is a one-time cost)
RUN python -c "import cmdstanpy; cmdstanpy.install_cmdstan(progress=False)"

# Copy all Python modules
COPY *.py ./

# Output directories — bind-mounted in compose; defined here for standalone use
RUN mkdir -p data analysis_output
